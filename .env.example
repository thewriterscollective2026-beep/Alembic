# ---- Copy this file to .env and fill in the values ----

# Google OAuth (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must EXACTLY match an Authorized redirect URI in your OAuth client:
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Anthropic (Claude) API key -> https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the newsletter-writing/research step (quality-sensitive)
CLAUDE_MODEL=claude-sonnet-5
# Model used for cheap/mechanical calls: sender categorization, source summarization
CLAUDE_MODEL_LIGHT=claude-haiku-4-5
# Thinking effort for the writing/research call: low/medium/high/xhigh/max.
# medium matches high-effort quality on research-shaped tasks for a fraction of the cost.
CLAUDE_WRITER_EFFORT=medium

# Secret used to sign login cookies (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Key used to encrypt stored Google tokens at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# How many days of mail to scan when detecting newsletters on first login
SCAN_DAYS=60

# Max messages to inspect during the newsletter-detection scan (keeps it fast)
SCAN_MESSAGE_LIMIT=400

# Max web searches Claude may run per newsletter-writing call (research step;
# cost/latency guardrail)
WEB_SEARCH_MAX_USES=4
